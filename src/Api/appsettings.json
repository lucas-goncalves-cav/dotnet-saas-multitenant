{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=SaasMultiTenant;User Id=sa;Password=your_password_here;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "saas-multitenant",
    "Audience": "saas-multitenant",
    "SigningKey": "your_jwt_signing_key_here_at_least_32_bytes",
    "ExpiryMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
