# Copy to .env and replace every value. Nothing here is a real credential.

# SQL Server needs a password of at least 8 characters with upper case, lower
# case, digits and symbols, or the container exits during startup.
SQL_PASSWORD=your_sql_password_here
SQL_DATABASE=SaasMultiTenant
SQL_PORT=1433

# At least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Every tenant boundary in this application rests on this key: anyone holding
# it can mint a token for any tenant, so it belongs in a secret store rather
# than in source control.
JWT_SIGNING_KEY=your_jwt_signing_key_here_at_least_32_bytes
JWT_ISSUER=saas-multitenant
JWT_AUDIENCE=saas-multitenant
JWT_EXPIRY_MINUTES=60

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
